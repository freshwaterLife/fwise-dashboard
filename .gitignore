# R session artefacts
.Rhistory
.Rapp.history
.RData
.Ruserdata
.Rproj.user/

# Credentials. Never commit these.
.Renviron
*.json
# Config, not credentials: Connect Cloud needs these.
!manifest.json
!renv.lock
# Published data (release date, row counts), not a secret.
!metadata.json

# Local scratch, including the dev/forms/ fallback. Ignore the contents, not the
# directory, so the negations below can re-include files.
dev/*
!dev/check_contrast.R
!dev/check_palette.R
!dev/check_literals.R
!dev/smoke_test.R
!dev/plan_test.R
!dev/check_sheets.R
!dev/value_test.R
!dev/qa.R
!dev/species_enrich.R
!dev/fetch_species_images.R
!dev/reconcile_source.R
!dev/archive/

# renv library is rebuilt from renv.lock.
renv/library/
renv/local/
renv/cellar/
renv/staging/
renv/python/
renv/sandbox/

# macOS
.DS_Store
